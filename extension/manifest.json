{
  "manifest_version": 3,
  "name": "StreamRatings – IMDb ratings on Netflix, Prime Video & JioHotstar",
  "short_name": "StreamRatings",
  "version": "1.1.0",
  "description": "See IMDb ratings on every title card on Netflix, Prime Video and JioHotstar. Free, uses your own OMDb key.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "StreamRatings settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.omdbapi.com/*",
    "https://streamratings-cache.rohan-trades-trump.workers.dev/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.hotstar.com/*",
        "https://*.jiohotstar.com/*"
      ],
      "js": [
        "shared/omdb.js",
        "shared/cache_policy.js",
        "content_scripts/main.js",
        "adapters/netflix.js",
        "adapters/prime.js",
        "adapters/hotstar.js",
        "ui/badge.js"
      ],
      "css": [
        "ui/badge.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  }
}
